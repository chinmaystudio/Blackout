# Appwrite Backend Configuration for BLACKOUT: FALLOUT
# Copy this file to .env and insert your project credentials from cloud.appwrite.io

VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_project_id_here
VITE_APPWRITE_DATABASE_ID=blackout_db
VITE_APPWRITE_COLLECTION_ID=registrations

# SMTP Mail Dispatcher Configuration (Vercel Environment Variables & Local .env)
# For Gmail: Use smtp.gmail.com, port 465 (SSL) or 587 (TLS), and a 16-character Google App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
SENDER_EMAIL=your_email@gmail.com

